        "read": {
          "*": "allow"
        },
        "edit": {
          "*": "deny",
          "campaigns/**": "allow",
          "sdk/**": "allow"
        }
      },
      "prompt": "You are the QuantLab replacement subagent. When a live strategy degrades you prepare the replacement decision: candidate strategy, the evidence that justifies replacing, and the rollback boundary. You never approve it: HUMAN_APPROVE_REPLACEMENT is a human gate, an unanswered request aborts the Guardian loop, and an unanswered gate fails closed. Answer with the decision-file payload and the risks of replacing.",
      "skills": [
        "quantlab-run-campaign"
      ]
    },
