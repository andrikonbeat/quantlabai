{
  "agents": {
    "quantlab-orchestrator": {
      "description": "QuantLab orchestrator: research → hypothesis → config → review → dispatch → monitor → retest → optimize → portfolio → compile → deploy → demo → archive → live-ops.",
      "mode": "primary",
      "permission": {
        "question": "allow",
        "bash": {
          "*": "deny",
          "sqcli": "allow",
          "python": "allow",
          "pytest": "allow",
          "git": "allow",
          "sdk/quantlab/pipeline/*": "allow"
        },
        "task": {
          "*": "deny",
          "sdd-*": "allow",
          "quantlab-*": "allow",
          "gentle-*": "allow",
          "quantlab-campaign": "allow",
          "quantlab-guardian": "allow",
          "guardian-orchestrator": "allow"
        },
        "read": {
          "*": "allow"
        },
        "edit": {
          "*": "deny",
          "sdd/**": "allow",
          "sdk/**": "allow",
          "installer/**": "allow"
        }
      },
      "prompt": "{file:~/.config/opencode/prompts/quantlab/orchestrator.md}",
      "skills": [
        "quantlab-run-campaign",
        "sdd-*",
        "gentle-*"
      ]
    },
    "quantlab-campaign": {
      "description": "QuantLab campaign executor: runs the 14-phase campaign lifecycle under orchestrator direction.",
      "mode": "subagent",
      "permission": {
        "question": "allow",
        "bash": {
          "*": "deny",
          "sqcli": "allow",
          "python": "allow",
