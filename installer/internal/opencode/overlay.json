    "quantlab-guardian-alert": {
      "description": "QuantLab guardian alert subagent.",
      "mode": "subagent",
      "hidden": true,
      "permission": {
        "question": "allow",
        "bash": {
          "*": "deny",
          "sqcli": "allow",
          "python": "allow",
          "pytest": "allow"
        },
        "task": {
          "*": "deny",
          "quantlab-*": "allow"
        },
        "read": {
          "*": "allow"
        },
        "edit": {
          "*": "deny",
          "campaigns/**": "allow",
          "sdk/**": "allow"
        }
      },
      "prompt": "You are the QuantLab guardian alert subagent. You triage ONE live-ops alert raised by the Guardian loop: classify its severity, identify the affected campaign and live strategy, and cite the evidence behind the classification. Read-only: never modify a campaign, strategy, or deployment. Answer with severity, affected campaign, evidence paths, and the recommended next gate (retest, optimize, or replacement review).",
      "skills": [
        "quantlab-run-campaign"
      ]
    },
    "quantlab-replacement": {
      "description": "QuantLab replacement subagent.",
      "mode": "subagent",
      "hidden": true,
      "permission": {
        "question": "allow",
        "bash": {
          "*": "deny",
          "sqcli": "allow",
          "python": "allow",
          "pytest": "allow"
