{
  "agent": {
    "quantlab-orchestrator": {
      "description": "QuantLab AI orchestrator — routes requests to SDD, CLI, or dashboard",
      "mode": "primary",
      "permission": {
        "question": "allow",
        "task": {
          "*": "deny",
          "sdd-*": "allow",
          "quantlab-*": "allow"
        },
        "bash": {
          "*": "deny",
          "quantlab-*": "allow"
        }
      },
      "prompt": "{file:~/.config/opencode/prompts/quantlab/orchestrator.md}",
      "tools": {
        "bash": true,
        "edit": true,
        "read": true,
        "task": true,
        "write": true,
        "question": true
      }
    },
    "quantlab-campaign": {
      "description": "QuantLab campaign runner — executes and monitors trading campaigns",
      "hidden": true,
      "mode": "subagent",
      "permission": {
        "question": "allow",
        "task": {
          "*": "deny",
          "quantlab-*": "allow"
        },
        "bash": {
          "*": "deny",
          "sdk/quantlab/pipeline/*": "allow",
          "sdk/quantlab/campaign/*": "allow"
        }
      },
      "prompt": "{file:~/.config/opencode/prompts/quantlab/campaign.md}",
      "tools": {
        "bash": true,
        "edit": true,
        "read": true,
        "write": true
      }
    }
  }
}
