{
  "agents": {
    "quantlab-orchestrator": {
      "description": "QuantLab orchestrator: research → hypothesis → config → review → dispatch → monitor → retest → optimize → portfolio → compile → deploy → demo → archive → live-ops.",
      "mode": "primary",
      "permissions": {
        "question": "allow",
        "bash": {
          "*": "deny",
          "sqcli": "allow",
          "python": "allow",
          "pytest": "allow",
          "git": "allow"
        },
        "task": {
          "*": "deny",
          "sdd-*": "allow",
          "quantlab-*": "allow",
          "gentle-*": "allow"
        },
        "read": {
          "*": "allow"
        },
        "write": {
          "*": "deny",
          "openspec/**": "allow",
          "sdk/**": "allow",
          "installer/**": "allow"
        },
        "edit": {
          "*": "deny",
          "openspec/**": "allow",
          "sdk/**": "allow",
          "installer/**": "allow"
        }
      },
      "prompt": "{file:~/.config/opencode/prompts/quantlab/orchestrator.md}",
      "skills": [
        "quantlab-run-campaign",
        "sdd-*",
        "gentle-*"
      ]
    },
