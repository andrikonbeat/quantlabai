# QuantLab AI - Environment Configuration
# Copy to .env and fill in your values

# ============================================================
# SQX Configuration
# ============================================================
# SQX_INSTALL_PATH points to the StrategyQuant X distribution root.
# There is no portable default: the distribution is a machine-local tool
# dependency and is never committed (see .gitignore: assets/SQX_*).
# Replace the placeholder below with YOUR install root, e.g.
#   Linux/WSL : /opt/SQX_144_2953_linux_20260601
#   Windows   : C:/Program Files/StrategyQuant/SQX_144_2953
# The CLI also accepts --sqx-path; SQX_PATH overrides the campaign runner default.
SQX_INSTALL_PATH=/path/to/your/SQX_install_root
SQX_PORT=5050
SQX_LICENSE=your-license-key-here

# ============================================================
# Knowledge Lake
# ============================================================
QUANTLAB_KNOWLEDGE_ROOT=/app/knowledge
QUANTLAB_REPORTS_DIR=/app/reports

# ============================================================
# API Server
# ============================================================
API_HOST=0.0.0.0
API_PORT=8080
API_WORKERS=4
API_TIMEOUT=300

# ============================================================
# Database (for multi-user RBAC - future)
# ============================================================
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_DB=quantlab
# POSTGRES_USER=quantlab
# POSTGRES_PASSWORD=your-secure-password-here

# ============================================================
# Redis (for caching, sessions, Celery)
# ============================================================
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password

# ============================================================
# Monitoring & Logging
# ============================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=

# ============================================================
# External Integrations
# ============================================================
# COINBASE_API_KEY=
# COINBASE_API_SECRET=
# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# ============================================================
# LLM (standalone/headless SDK research only)
# ============================================================
# The orchestrated campaign flow consumes the OpenCode subagent's own model
# and needs NO API key. The standalone SDK research path (research_llm /
# LLMConfig with provider="opencode") uses the OpenCode Zen free tier by
# default: base_url https://opencode.ai/zen/v1, model deepseek-v4-flash-free.
# Get your key at https://opencode.ai/auth (no credit card required).
OPENCODE_API_KEY=your-opencode-api-key

# ============================================================
# Security
# ============================================================
SECRET_KEY=your-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7

# ============================================================
# Feature Flags
# ============================================================
ENABLE_REPORTING=true
ENABLE_KNOWLEDGE_QUERY=true
ENABLE_PIPELINE_EXECUTION=true
ENABLE_MULTI_USER=false