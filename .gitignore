# Java
*.class
*.jar
target/
*.war
# ... except the Gradle wrapper jar: it is the bootstrap artifact for every
# Android build and must be versioned or a fresh clone cannot build at all.
!app_movil/**/gradle/wrapper/gradle-wrapper.jar

# Android
app_movil/**/build/
app_movil/**/.gradle/
.kotlin/
.classes/
*.apk
*.aab

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS / Windows
.DS_Store
Thumbs.db
*.Zone.Identifier

# Knowledge Lake raw data (potentially large)
knowledge/raw/*
!knowledge/raw/.gitkeep

# SQX
*.cfx
*.sqx
*.sqxc
databanks/
# ... except the reduced golden fixture, which is committed test evidence rather
# than a machine-local SQX artifact. Named explicitly so the Builder.cfx /
# NQ_CFD_H1.cfx symlinks into the local install stay ignored.
!tests/cfx/fixtures/retester-advanced-rankings.cfx
# SQX distribution (local tool dependency, kept on external volume; see HGN-02)
assets/SQX_*.zip
assets/SQX_*
# NOTE: no trailing slash — the repo-local assets/SQX_* entry is a symlink to
# the real install (~/Proyectos/SQX_144_2953_linux_20260601) and git does not
# treat directory patterns with a trailing slash as matching symlinks.

# Logs
*.log

# Generated output files
_output/
reports/
_evolution_pool/

# Local tooling / caches
.codegraph/
.evolution_pool/
sdk/.evolution_pool/
.atl/.skill-registry.cache.json

# SQX runtime artifacts (generated data, temp/lock DBs, wizard state)
assets/**/internal/testfiles/
assets/**/user/data/*.h2.db
assets/**/user/data/*.temp.db
assets/**/user/data/*.lock.db
assets/**/user/data/*.version
assets/**/user/settings/wizard.txt

# Runtime databases
**/monitor.db

# Deployment scratch / run artifacts
# Anchored to the repo root with a leading slash. Unanchored, these two patterns
# matched at EVERY depth and silently swallowed real source: `sdk/quantlab/analysis/`
# (frame/indicators/regime/sentiment) and the OpenSpec capability dir
# `sdd/changes/*/specs/deploy/`. Anchored, they mean what the comment says.
/deploy/
notifications.jsonl
/analysis/

# Stray junk
missing.jfx
# Local Pi runtime state
.atl/
