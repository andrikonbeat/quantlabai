{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quantlab.ai/schemas/pipeline-config.schema.json",
  "title": "QuantLab Multi-Agent Pipeline Configuration",
  "description": "Schema for declarative pipeline YAML with agents, gates, memory, and risk sections",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "pipeline": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "default": "" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "default": "1.0.0" },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "enum": [
                "validate", "translate", "daemon_start", "load_config", "run_campaign",
                "poll_campaign", "campaign", "export", "read", "compute_stats",
                "knowledge_store", "report",
                "research", "builder", "statistics", "review", "portfolio",
                "deploy", "monitor", "research_director"
              ]},
              "type": { "type": "string", "enum": ["builtin", "agent", "gate"] },
              "agent": { "type": "string", "default": "" },
              "enabled": { "type": "boolean", "default": true },
              "requires": {
                "type": "array",
                "items": { "type": "string" },
                "default": []
              },
              "provides": {
                "type": "array",
                "items": { "type": "string" },
                "default": []
              },
              "gate_after": { "type": "string", "default": "" },
              "timeout": { "type": "number", "minimum": 1, "default": 300 },
              "max_retries": { "type": "integer", "minimum": 0, "default": 3 },
              "config": { "type": "object", "additionalProperties": true, "default": {} }
            }
          }
        }
      }
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "default": "" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "default": "1.0.0" },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["builtin", "agent", "gate"] },
          "agent": { "type": "string", "default": "" },
          "enabled": { "type": "boolean", "default": true },
          "requires": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          },
          "provides": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          },
          "gate_after": { "type": "string", "default": "" },
          "timeout": { "type": "number", "minimum": 1, "default": 300 },
          "max_retries": { "type": "integer", "minimum": 0, "default": 3 },
          "config": { "type": "object", "additionalProperties": true, "default": {} }
        }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "enabled": { "type": "boolean", "default": true },
          "model": { "type": "string", "default": "gpt-4" },
          "temperature": { "type": "number", "minimum": 0.0, "maximum": 2.0, "default": 0.3 },
          "max_tokens": { "type": "integer", "minimum": 100, "maximum": 32000, "default": 4000 },
          "max_retries": { "type": "integer", "minimum": 0, "default": 2 },
          "timeout_seconds": { "type": "integer", "minimum": 1, "default": 3600 },
          "tools": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          },
          "memory": {
            "type": "object",
            "properties": {
              "enabled": { "type": "boolean", "default": true },
              "ttl_hours": { "type": "number", "default": 168 },
              "max_entries": { "type": "integer", "default": 1000 }
            }
          },
          "config": { "type": "object", "additionalProperties": true, "default": {} }
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "gate_id": { "type": "string" },
          "type": { "type": "string", "default": "human_approval" },
          "timeout_hours": { "type": "number", "minimum": 0.1, "default": 24 },
          "fallback": { "type": "string", "enum": ["ABORT", "CONTINUE", "ESCALATE"], "default": "CONTINUE" },
          "required_approvers": { "type": "integer", "minimum": 1, "default": 1 },
          "after_stage": { "type": "string", "default": "" },
          "requires": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          },
          "notifications": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          },
          "escalate_to": {
            "type": "string",
            "default": ""
          },
          "config": { "type": "object", "additionalProperties": true, "default": {} }
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "topic_prefix": { "type": "string", "default": "quantlab/agent" },
        "ttl_hours": { "type": "number", "default": 168 },
        "max_entries": { "type": "integer", "default": 1000 },
        "retention_days": { "type": "integer", "minimum": 1, "default": 365 },
        "cross_agent_sharing": { "type": "boolean", "default": true },
        "persistence": { "type": "string", "enum": ["engram", "knowledge", "both"], "default": "both" }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_portfolio_drawdown": { "type": "number", "minimum": 0.01, "maximum": 1.0, "default": 0.15 },
        "max_single_strategy_risk": { "type": "number", "minimum": 0.001, "maximum": 1.0, "default": 0.03 },
        "max_strategy_correlation": { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.7 },
        "max_single_strategy_weight": { "type": "number", "minimum": 0.01, "maximum": 1.0, "default": 0.4 },
        "kelly_fraction": { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.5 },
        "kelly_fraction_cap": { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.25 },
        "var_confidence": { "type": "number", "minimum": 0.5, "maximum": 0.999, "default": 0.95 },
        "max_open_positions": { "type": "integer", "minimum": 1, "default": 10 }
      }
    }
  }
}
